{
  "hosting": {
    "site": "encompax-iris",
    "public": "apps/web/public",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "apps/api/**",
      "services/**",
      "packages/**",
      "data/**",
      "docs/**",
      "tests/**",
      "README.md",
      "ROLLOUT_READINESS_AUDIT.md",
      "IRIS_RELEASE_CHECKLIST.md"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "run": {
          "serviceId": "encompax-iris-api",
          "region": "us-central1"
        }
      },
      {
        "source": "/health",
        "run": {
          "serviceId": "encompax-iris-api",
          "region": "us-central1"
        }
      }
    ]
  }
}
